{
  "ConnectionStrings": {
    "PayrollDb": "host=psql-hrmsdev-dtg9s0.postgres.database.azure.com port=5432 dbname=postgres user=aks-hrmsdev-identity sslmode=require"
  },
  "Jwt": {
    "Issuer": "hr-payroll",
    "Audience": "hr-payroll-clients",
    "SigningKey": "please_change_this_super_secret_key_123456"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "OTEL_EXPORTER_OTLP_ENDPOINT": "http://localhost:4317",
  "AllowedHosts": "*"
}
